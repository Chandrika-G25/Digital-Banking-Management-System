# =====================================================================
# SecureBank Production Environment Configuration Template
# Set these environment variables in Render, Railway, or your cloud host.
# =====================================================================

# Security
SECRET_KEY=generate-a-strong-random-secret-key-here-min-50-chars
DEBUG=False
ALLOWED_HOSTS=*

# MySQL Production Database Configuration
# Option A: Full Connection URL (Render/Railway/PlanetScale/Aiven/AWS)
# DATABASE_URL=mysql://db_user:db_password@db_host:3306/securebank

# Option B: Individual Database Parameters
DB_ENGINE=mysql
DB_NAME=securebank
DB_USER=root
DB_PASSWORD=your_strong_mysql_password
DB_HOST=your-mysql-hostname.example.com
DB_PORT=3306

# CORS & CSRF (Set to your Vercel frontend domain)
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.vercel.app,https://*.vercel.app,https://*.onrender.com,https://*.railway.app

# Real-time WebSocket Layer (inmemory for single-instance, redis for multi-instance)
CHANNEL_LAYER_BACKEND=inmemory
# REDIS_URL=redis://default:password@redis-host:6379

# Initial Demo Credential Seed (Optional)
DEMO_PASSWORD=SecureDemoPass2026!#
