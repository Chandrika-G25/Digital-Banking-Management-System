# =====================================================================
# SecureBank Frontend Environment Variables Template
# Set these in your Vercel Project Settings -> Environment Variables
# =====================================================================

# URL of your deployed Django backend (Render, Railway, AWS, etc.)
# Leave blank for local development to use Vite local proxy (http://127.0.0.1:8000)
VITE_API_URL=https://your-securebank-backend.onrender.com

# Real-time WebSocket URL (Optional: auto-derived from VITE_API_URL if omitted)
VITE_WS_URL=wss://your-securebank-backend.onrender.com
